[Unit]
Description=Qujianma Node Recognition Worker
After=network-online.target qujianma-node-api.service
Wants=network-online.target

[Service]
Type=simple
User=qujianma
Group=qujianma
WorkingDirectory=/opt/qujianma-node/current
Environment=RECOGNITION_WORKER_ENABLED=true
Environment=INSTALL_DATA_ROOT=/opt/qujianma-node/shared
ExecStart=/opt/qujianma-node/current/scripts/systemd-worker-entrypoint.sh /usr/bin/node /opt/qujianma-node/current/dist/recognition-worker.js
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qujianma-node/shared/recognition-uploads
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target